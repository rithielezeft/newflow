[Unit]
Description=NewFlow Backend (FastAPI - uvicorn)
After=network.target

[Service]
User=rithiele
WorkingDirectory=/home/rithiele/websites/newflow/backend
ExecStart=/home/rithiele/websites/newflow/backend/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
